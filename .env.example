# MongoDB Atlas connection string
MONGODB_URI=

# Database name (optional, defaults to "docchat")
MONGODB_DB=docchat

# Google Gemini API key (LLM + embeddings)
GEMINI_API_KEY=

# Optional model overrides
# Chat model (defaults to gemini-flash-latest)
GEMINI_CHAT_MODEL=
# Embedding model (defaults to gemini-embedding-001, 768-dim output)
GEMINI_EMBEDDING_MODEL=
